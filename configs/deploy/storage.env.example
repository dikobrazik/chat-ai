# Generate independent random credentials; do not reuse cloud-provider keys.
S3_ACCESS_KEY_ID=(openssl rand -hex 16)
S3_SECRET_ACCESS_KEY=(openssl rand -hex 32)
# Preserve current bucket names when migrating existing objects.
USER_FILES_BUCKET_NAME=jonu-user-files
GENERATED_IMAGES_BUCKET_NAME=jonu-generated-images
